# Default Top-K for the Q&A page's question box. A higher value means a
# longer prompt sent to the LLM -- on CPU-backed local inference (Ollama)
# this can push a single query from ~40s to several minutes. No secrets
# here (Vite exposes VITE_-prefixed vars in the client bundle), so this
# file is committed rather than gitignored like backend/.env.
VITE_DEFAULT_TOP_K=3
