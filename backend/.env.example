RAG_LLM_PROVIDER=anthropic

# Used when RAG_LLM_PROVIDER=anthropic
RAG_ANTHROPIC_API_KEY=
RAG_ANTHROPIC_MODEL=claude-sonnet-5

# Used when RAG_LLM_PROVIDER=ollama -- no API key needed, but Ollama must be
# installed and running locally with the model pulled (e.g. `ollama pull llama3.1`)
RAG_OLLAMA_BASE_URL=http://localhost:11434
RAG_OLLAMA_MODEL=llama3.1

# Optional: forwarded as options.num_gpu on each Ollama request. Leave unset
# to let Ollama decide GPU layer offload automatically. Set to 0 to force
# CPU-only, e.g. if a small GPU's partial offload is slower than pure CPU.
#RAG_OLLAMA_NUM_GPU=0

RAG_VECTOR_STORE_PROVIDER=faiss

# Used when RAG_VECTOR_STORE_PROVIDER=pinecone -- requires a Pinecone account
# (pinecone.io) and API key. The serverless index is created automatically
# on first use if it doesn't already exist, with dimension=384 (matching
# all-MiniLM-L6-v2) and metric=cosine.
RAG_PINECONE_API_KEY=
RAG_PINECONE_INDEX_NAME=construction-rag
RAG_PINECONE_CLOUD=aws
RAG_PINECONE_REGION=us-east-1

# Used when RAG_VECTOR_STORE_PROVIDER=weaviate -- requires a Weaviate Cloud
# account (console.weaviate.cloud), a cluster URL, and an API key. The
# collection is created automatically on first use if it doesn't already
# exist, with vectorizer=none (we supply our own vectors) and
# distance_metric=cosine.
RAG_WEAVIATE_CLUSTER_URL=
RAG_WEAVIATE_API_KEY=
RAG_WEAVIATE_COLLECTION_NAME=ConstructionRagChunk
