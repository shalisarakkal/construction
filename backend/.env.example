RAG_LLM_PROVIDER=anthropic

# Used when RAG_LLM_PROVIDER=anthropic
RAG_ANTHROPIC_API_KEY=
RAG_ANTHROPIC_MODEL=claude-sonnet-5

# Used when RAG_LLM_PROVIDER=ollama -- no API key needed, but Ollama must be
# installed and running locally with the model pulled (e.g. `ollama pull llama3.1`)
RAG_OLLAMA_BASE_URL=http://localhost:11434
RAG_OLLAMA_MODEL=llama3.1

# Optional: forwarded as options.num_gpu on each Ollama request. Leave unset
# to let Ollama decide GPU layer offload automatically. Set to 0 to force
# CPU-only, e.g. if a small GPU's partial offload is slower than pure CPU.
#RAG_OLLAMA_NUM_GPU=0
